{
    "name": "dumont/dumont-ws",
    "description": "Sample application for the workshop: one todo list in the terminal on a minimal Symfony setup",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/tui": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
