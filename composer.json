{
    "name": "dumont/dumont-ws",
    "description": "Sample application for the workshop: one todo list in the terminal on a minimal Symfony setup",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "psr/event-dispatcher": "^1.0",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/tui": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "ext-tokenizer": "*",
        "ergebnis/phpstan-rules": "^2.17.0",
        "erickskrauch/php-cs-fixer-custom-fixers": "^1.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "nikic/php-parser": "^5.9",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-arch": "^5.0.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "~2.2.16",
        "phpstan/phpstan-phpunit": "^2.0.19",
        "phpstan/phpstan-symfony": "~2.0.20",
        "phpunit/phpunit": "^13.4.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/config": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/process": "8.1.*",
        "ta-tikoma/phpunit-architecture-test": "^0.8.7",
        "tomasvotruba/type-coverage": "^2.5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tools\\": "tools/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "process-timeout": 0
    },
    "scripts": {
        "test": [
            "pest"
        ],
        "quality": [
            "php-cs-fixer fix",
            "php-cs-fixer check --using-cache=no",
            "phpstan analyse --memory-limit=1G",
            "composer-dependency-analyser"
        ],
        "quality:check": [
            "php-cs-fixer check",
            "phpstan analyse --memory-limit=1G",
            "composer-dependency-analyser"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs all tests: architecture, unit and integration",
        "quality": "Fixes the code style, then checks it, runs PHPStan and checks the declared dependencies",
        "quality:check": "Checks the code style without fixing it, runs PHPStan and checks the declared dependencies"
    }
}
