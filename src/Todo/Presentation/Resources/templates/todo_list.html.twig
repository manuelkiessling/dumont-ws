<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Todo</title>
</head>
<body>
    <h1>Todo</h1>

    {% if refusal %}
        <p role="alert" data-test-id="refusal"><strong>{{ refusal }}</strong></p>
    {% endif %}

    <form method="post" action="{{ path('todo.presentation.add_item') }}" data-test-id="add-item-form">
        <label for="text">What is there to do?</label>
        <input type="text" id="text" name="text" value="{{ text }}" maxlength="{{ maxTextLength }}" required autofocus>
        <button type="submit">Add</button>
    </form>

    {% if items is empty %}
        <p data-test-id="empty-list">Nothing to do.</p>
    {% else %}
        <ul data-test-id="items">
            {% for item in items %}
                <li data-test-id="item" data-item-id="{{ item.id }}">
                    {% if item.done %}
                        <s>{{ item.text }}</s> (done {{ item.doneAt|date('Y-m-d H:i') }})
                    {% else %}
                        {{ item.text }}
                        <form method="post" action="{{ path('todo.presentation.mark_item_done', {itemId: item.id}) }}" style="display: inline">
                            <button type="submit" data-test-id="mark-done">Done</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('todo.presentation.delete_item', {itemId: item.id}) }}" style="display: inline">
                        <button type="submit" data-test-id="delete">Delete</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</body>
</html>
